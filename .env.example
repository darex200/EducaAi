# --- OpenAI ---
# Necesaria para el tutor, análisis de documentos y generación de imágenes (DALL·E 3).
OPENAI_API_KEY="sk-..."
# Solo desarrollo local (Windows/antivirus): si ves "fetch failed" / certificado SSL
# OPENAI_INSECURE_SSL="true"

# --- Modo de la app (demo por defecto, sin correo ni base de datos) ---
# No configures APP_MODE ni NEXT_PUBLIC_APP_MODE en Vercel si no usas Supabase.
# APP_MODE="database"
# NEXT_PUBLIC_APP_MODE="database"
# ENABLE_DATABASE="true"
# NEXT_PUBLIC_ENABLE_DATABASE="true"
#
# --- Supabase Postgres (Settings -> Database -> Connection string) ---
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth.js (solo si ENABLE_DATABASE=true) ---
# AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio"

# --- Supabase Storage (opcional, para documentos) ---
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
